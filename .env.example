# LLM upstream (по умолчанию OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
#
# Если OpenRouter недоступен с VPS (Cloudflare 403) — локальный Ollama:
# OPENROUTER_URL=http://127.0.0.1:11434/v1/chat/completions
# OPENROUTER_MODEL=qwen2.5:1.5b
# OPENROUTER_API_KEY=ollama-local

# Web UI (обязательно для python -m na_glazok)
WEB_USERNAME=naglazok
WEB_PASSWORD=change-me
# WEB_HOST=127.0.0.1
# WEB_PORT=8080

# Telegram — опционально (python -m na_glazok.bot)
# TELEGRAM_BOT_TOKEN=123456:ABCDEF...

# Опционально
# GATEWAY_RATE_LIMIT=40
