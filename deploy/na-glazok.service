[Unit]
Description=На Глазок Telegram bot (KBJU + gateway + Security Step)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=naglazok
Group=naglazok
WorkingDirectory=/opt/na-glazok
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
EnvironmentFile=/opt/na-glazok/.env
ExecStart=/opt/na-glazok/.venv/bin/python -m na_glazok
Restart=always
RestartSec=5
# Логи: journalctl -u na-glazok -f

[Install]
WantedBy=multi-user.target
